# Owner bootstrap password: при первом старте player создаёт владельца с этим
# паролем (если владелец уже есть — не используется). Опционально, но без него
# и без /api/auth/setup вход невозможен. Никогда не коммить реальные значения.
MUSIC_HIVE_PASSWORD=
MUSIC_HIVE_SESSION_SECRET=
# MUSIC_HIVE_SECURE_COOKIE=1   # enable when serving over HTTPS
# MUSIC_HIVE_AUTH_DISABLED=1   # ONLY local open mode — never on public IP
# MUSIC_HIVE_CORS_ORIGINS=https://app.example.com  # cross-origin clients; empty = same-origin
# MUSIC_HIVE_CANDIDATE_POOL_AT=8000  # shortlist queue when N>=this (use 50 to test on small libs)

# Library path on the host (mounted into containers as /music)
MUSIC_HIVE_LIBRARY=/path/to/music

# --- PostgreSQL (F1, основное хранилище; схема — `music-hive-player migrate`) ---
# Compose собирает DSN сам (postgres://music_hive:<пароль>@postgres:5432/music_hive).
# Задавать целиком нужно только для внешнего/удалённого PG — тогда перекрывает сборку:
# MUSIC_HIVE_DATABASE_URL=postgres://music_hive:music_hive@postgres:5432/music_hive?sslmode=disable
# Пароль postgres (дефолт music_hive — только для dev; для VPS смени!)
# MUSIC_HIVE_PG_PASSWORD=music_hive
# localhost-порт postgres для dev-файла docker-compose.postgres.yml
# MUSIC_HIVE_PG_PORT=5432

# Auto-watch library folder: music-hive watch
# MUSIC_HIVE_WATCH_DEBOUNCE_SEC=45
# MUSIC_HIVE_WATCH_CLUSTERS=1
# MUSIC_HIVE_WATCH_MIXES=1

# Absolute URLs for share radio
# MUSIC_HIVE_PUBLIC_BASE_URL=https://music.example.com
# MUSIC_HIVE_FFMPEG=ffmpeg
# MUSIC_HIVE_SHARE_BITRATE=192k
# MUSIC_HIVE_SHARE_MAX_LISTENERS=4
# Android/LTE transcode cache
# MUSIC_HIVE_MOBILE_BITRATE=160k
# MUSIC_HIVE_MOBILE_FORMAT=aac

# Optional tuning
MUSIC_HIVE_WORKERS=4
# Faster radio adaptation (defaults also raised in player)
MUSIC_HIVE_TASTE_ALPHA=0.22
MUSIC_HIVE_PROFILE_FORMING_AT=3
MUSIC_HIVE_PROFILE_READY_AT=8
MUSIC_HIVE_EXPLORE_RATIO=0.15
MUSIC_HIVE_DISCOVER_EXPLORE=0.35
MUSIC_HIVE_QUEUE_SIZE=6
# MUSIC_HIVE_PLAYER_ADDR=0.0.0.0:8787
# MUSIC_HIVE_PUBLIC_BASE_URL=http://192.168.x.x:8787
# MUSIC_HIVE_WORKER_URL=http://127.0.0.1:8790
# MUSIC_HIVE_NEW_TRACK_DAYS=14
# MUSIC_HIVE_NEW_ALBUM_DAYS=14
# Rebuild all recommendation playlists every night.
# MUSIC_HIVE_NIGHTLY_MIXES_ENABLED=1
# MUSIC_HIVE_NIGHTLY_MIXES_HOUR=3
# MUSIC_HIVE_NIGHTLY_MIXES_TIMEZONE=Europe/Moscow  # IANA timezone; "local" uses host/container TZ
