# Runtime / personal library data
data/**
!data/.gitkeep
!data/music/
data/music/**
!data/music/.gitkeep

# Secrets and private deployment configuration
.env
*.env
!.env.example
secrets.env
**/secrets.env
/deploy/
deploy/
*.pem
*.key
**/id_ed25519
**/id_rsa
**/known_hosts
**/.ssh/

# Personal exports and reports
vk-wishlist*.json
*wishlist*.json
docs/paper-*
*.log
*.npy
*.npz

# Python / ML environments
.venv/
.venv-rocm/
.rocm-extra/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
dist/
build/

# Vite build output embedded into the Go binary (issue #48): дерево
# player/internal/static/dist/ игнорируется (собранные бандлы с хешами
# в имени), кроме index.html-плейсхолдера — без него go:embed all:dist
# не собирается на чекауте без npm build.
!player/internal/static/dist/
player/internal/static/dist/*
!player/internal/static/dist/index.html

# Compiled artifacts
*.apk
*.aab
*.ipa
player/bin/

# Flutter / Android local state
# The Flutter application is published as a separate repository.
mobile/flutter/
mobile/flutter/.dart_tool/
mobile/flutter/.idea/
mobile/flutter/android/.gradle/
mobile/flutter/android/local.properties
*.iml

# Editors and local agent artifacts
.cursor/
.vscode/
.DS_Store

# Reports / coverage
coverage/
htmlcov/
.coverage

# Agent tooling
.serena/

# F4.2: ONNX-веса (сотни МБ — гигабайты) экспортируются локально, не коммитятся
models.d/**/*.onnx
