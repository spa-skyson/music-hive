# syntax=docker/dockerfile:1.7
# Development player: source is bind-mounted, Go caches survive restarts.
FROM golang:bookworm

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/player
ENV GOTOOLCHAIN=auto \
    MUSIC_HIVE_PLAYER_ADDR=:8787 \
    MUSIC_HIVE_WORKER_AUTOSTART=0 \
    MUSIC_HIVE_LIBRARY=/music \
    MUSIC_HIVE_WORKER_URL=http://worker:8790 \
    MUSIC_HIVE_ROOT=/workspace

COPY player/go.mod player/go.sum ./
RUN go mod download

EXPOSE 8787
CMD ["go", "run", "./cmd/music-hive-player"]
